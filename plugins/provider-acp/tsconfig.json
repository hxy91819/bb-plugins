{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "src",
    "vitest.config.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts"
  ]
}
