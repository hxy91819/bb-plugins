{
  "name": "bb-plugin-acp-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run bb threads with ACP agents (supports Cursor, opencode, omp, DeepSeek Harness and more).",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "ACP extensions",
    "description": "Run bb threads with ACP agents (supports Cursor, opencode, omp, DeepSeek Harness and more).",
    "branding": {
      "icon": "./icons/acp.svg",
      "experimental_icons": {
        "cursor": "./icons/cursor.svg",
        "opencode": "./icons/opencode.svg",
        "omp": "./icons/omp.svg",
        "grok": "./icons/grok.svg",
        "hermes-agent": "./icons/hermes-agent.svg",
        "dsh": "./icons/dsh.svg"
      }
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "acp-cursor",
        "displayName": "Cursor"
      },
      {
        "kind": "agent",
        "id": "acp-opencode",
        "displayName": "OpenCode"
      },
      {
        "kind": "agent",
        "id": "acp-omp",
        "displayName": "oh-my-pi"
      },
      {
        "kind": "agent",
        "id": "acp-grok",
        "displayName": "Grok"
      },
      {
        "kind": "agent",
        "id": "acp-hermes-agent",
        "displayName": "Hermes"
      }
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "build": "bb plugin build .",
    "format:check": "prettier --check package.json tsconfig.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.13.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1",
    "prettier": "3.8.3",
    "oxlint": "^1.79.0"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "https://github.com/hxy91819/bb/releases/download/fork-v0.46.0-20261016.6/bb-plugin-sdk-fork-v0.46.0-20261016.6.tgz",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxy91819/bb-plugins.git",
    "directory": "plugins/provider-acp"
  }
}
