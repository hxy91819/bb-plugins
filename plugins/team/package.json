{
  "name": "bb-plugin-team",
  "version": "0.2.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxy91819/bb-plugins.git",
    "directory": "plugins/team"
  },
  "scripts": {
    "test": "vitest run --config tests/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "check": "npm run test && npm run lint && npm run format:check && npm run typecheck && npm run build",
    "format": "prettier --write server.ts app.tsx src/*.ts tests/*.ts scripts/*.mjs",
    "format:check": "prettier --check server.ts app.tsx src/*.ts tests/*.ts scripts/*.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:all": "node scripts/audit.mjs --all",
    "package:release": "node scripts/package-release.mjs"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./contracts": "./src/contracts.ts"
  },
  "engines": {
    "node": ">=24",
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Team",
    "description": "Trusted team identities, thread attribution and bounded activity",
    "branding": {
      "icon": "Users"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/team-activity"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "https://github.com/hxy91819/bb/releases/download/fork-v0.46.0-20261014.3/bb-plugin-sdk-fork-v0.46.0-20261014.3.tgz",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.46.0",
    "better-sqlite3": "^12.0.0",
    "eslint": "9.39.1",
    "hono": "^4.11.9",
    "jsdom": "29.0.1",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "@testing-library/dom": "^10.4.1"
  },
  "description": "Trusted team attribution and retained activity; requires the compatible BB fork, not stock 0.46.0.",
  "overrides": {
    "npm": "12.2.0"
  }
}
