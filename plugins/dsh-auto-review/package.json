{
  "name": "bb-plugin-dsh-auto-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH native per-tool Auto review with BB approval fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxy91819/bb-plugins.git",
    "directory": "plugins/dsh-auto-review"
  },
  "engines": {
    "bb": ">=0.47.0",
    "bbPluginSdk": ">=0.6.75 <0.7.0"
  },
  "bb": {
    "name": "DSH Auto Review",
    "description": "Run DSH native Auto review and ask in BB when review denies a tool.",
    "branding": {
      "icon": "ShieldCheck"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "dsh-auto-review",
        "displayName": "DSH Auto Review"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build .",
    "lint": "oxlint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "https://github.com/hxy91819/bb/releases/download/fork-v0.47.0-20261029.1/bb-plugin-sdk-fork-v0.47.0-20261029.1.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1",
    "prettier": "3.8.3",
    "oxlint": "^1.79.0"
  }
}
